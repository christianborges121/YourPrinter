# ==========================================
# YourPrinter Docker Environment Configuration
# ==========================================

# WebUI Port (default: 3000 backend, 3080 web)
WEBUI_PORT=3000
WEBUI_PASSWORD=

# Watchdog REST API Port (default: 8085)
WATCHDOG_PORT=8085
WATCHDOG_URL=http://watchdog:8085

# Primary Printer Name (default: Flashforge Creator 5 Pro)
PRINTER_NAME=Flashforge Creator 5 Pro
PRINTER_TYPE=flashforge
PRINTER_IP=

# Flashforge Discovery / Auth Credentials
FLASHFORGE_SERIAL=
FLASHFORGE_CHECK_CODE=
FLASHFORGE_PORT=8898

# Discord Webhook URL for Alerts & Status Updates
DISCORD_WEBHOOK=

# Watchdog Failure Detection Settings
CONFIDENCE_THRESHOLD=0.20
CONSECUTIVE_REQUIRED=2
CHECK_INTERVAL_SEC=15
ALERT_COOLDOWN_SEC=60
AUTO_PAUSE_ON_FAILURE=true
WATCH_ONLY_WHILE_PRINTING=true
IDLE_POLL_INTERVAL_SEC=15

# Discord Alert Toggles
SEND_STARTUP_ALERT=true
SEND_PRINT_START_ALERT=true
SEND_PRINT_PROGRESS_ALERT=true
SEND_PRINT_PAUSE_ALERT=true
SEND_PRINT_RESUME_ALERT=true
SEND_PRINT_COMPLETE_ALERT=true
SEND_RESOLVED_ALERT=true
