# ==========================================
# YourPrinter AI Watchdog Configuration
# ==========================================

# Display name for Discord notifications
PRINTER_NAME=3D Printer

# Discord Webhook URL for print failure & state change alerts
DISCORD_WEBHOOK=

# WebUI / Core Backend URL (inside Docker network: http://yourprinter:3000)
FLASHFORGE_UI_URL=http://yourprinter:3000

# Embedded REST API Port for WebUI status & dynamic config updates
WATCHDOG_API_PORT=8085

# Minimum confidence required for failure detection (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.20

# Number of consecutive failed frames required to alarm & auto-pause (filters out artifacts/shadows)
CONSECUTIVE_REQUIRED=2

# Sampling interval while actively printing (seconds)
CHECK_INTERVAL_SEC=15

# Cooldown between repeated Discord failure alerts while a print remains in alert state (seconds)
ALERT_COOLDOWN_SEC=60

# Automatically trigger print pause on verified failure
AUTO_PAUSE_ON_FAILURE=true

# Discord Notification Toggles
SEND_STARTUP_ALERT=true
SEND_PRINT_START_ALERT=true
SEND_PRINT_PROGRESS_ALERT=true
SEND_PRINT_PAUSE_ALERT=true
SEND_PRINT_RESUME_ALERT=true
SEND_PRINT_COMPLETE_ALERT=true
SEND_RESOLVED_ALERT=true

# Camera & Polling Defaults
WATCH_ONLY_WHILE_PRINTING=true
IDLE_POLL_INTERVAL_SEC=15
SNAPSHOTS_DIR=/app/snapshots
